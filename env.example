# Zappicare Backend Environment Configuration

# Application
NODE_ENV=development
PORT=3000
APP_NAME=Zappicare Backend
APP_VERSION=1.0.0

# PostgreSQL — either DATABASE_URL or DB_* (see .env.example)
# Create DB, then: npm run migrate:latest && npm run seed
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zappicare
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zappicare
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_MIGRATIONS_TABLE=knex_migrations
DB_DATA_SCHEMA=data
DB_AUDIT_SCHEMA=audit
DB_PUBLIC_SCHEMA=public

# JWT
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
