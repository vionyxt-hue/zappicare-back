# Zappicare Backend Environment Configuration

# Application
NODE_ENV=development
PORT=3000
APP_NAME=Zappicare Backend
APP_VERSION=1.0.0

# MongoDB
MONGODB_URI=mongodb://localhost:27017/zappicare

# JWT
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
