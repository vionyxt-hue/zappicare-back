# App
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/zappicare

# JWT (required; min 32 chars)
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# AWS S3 (optional; required for provider document uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=your-bucket-name
# Optional: custom base URL for document links (e.g. CloudFront)
# S3_PUBLIC_BASE_URL=https://your-cdn.example.com

# CORS
CORS_ORIGIN=http://localhost:3000
