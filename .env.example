# App
NODE_ENV=development
PORT=3000

# PostgreSQL — either DATABASE_URL **or** DB_HOST / DB_NAME / …
# Create DB, then: npm run migrate:latest && npm run seed
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zappicare

DB_HOST=localhost
DB_PORT=5432
DB_NAME=zappicare
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_MIGRATIONS_TABLE=knex_migrations
DB_DATA_SCHEMA=data
DB_AUDIT_SCHEMA=audit
DB_PUBLIC_SCHEMA=public
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# JWT (required; min 32 chars)
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# AWS S3 (optional; required for provider document uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=your-bucket-name
# Optional: custom base URL for document links (e.g. CloudFront)
# S3_PUBLIC_BASE_URL=https://your-cdn.example.com

# CORS
CORS_ORIGIN=http://localhost:3000
